HF_ENDPOINT=https://hf-mirror.com
FASTEMBED_CACHE_PATH=~/.cache/fastembed
# PostgreSQL（对应 L2-pgvector/README 的 pg-memory-lab 容器，5433 避开本机 5432）
PG_DSN=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# DeepSeek（OpenAI 兼容）：docstring 增强/摘要/agent loop 都要用
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-v4-flash
