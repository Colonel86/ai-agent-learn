# 复制为 .env 并填入你的 API Key（全课程共享，放 code/ 根目录）
# cp .env.example .env

# chat：任意 OpenAI 兼容 API（Letta server 用 OPENAI_API_KEY 鉴权）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-v4-flash          # L1（裸 OpenAI SDK）用
LETTA_MODEL=deepseek-v4-flash    # L3-L6（Letta server）用

# embedding：本地 fastembed，模型缓存与 HF 镜像
HF_ENDPOINT=https://hf-mirror.com
FASTEMBED_CACHE_PATH=/Users/yourname/.cache/fastembed

# letta 0.16 server 只支持 PostgreSQL（sqlite 已废）；复用 12a 的 pgvector 实例，
# 库需预建：CREATE DATABASE letta; CREATE EXTENSION vector;
LETTA_PG_URI=postgresql://postgres:postgres@127.0.0.1:5433/letta?sslmode=disable
