# 复制为 .env 并填入你的 API Key
# cp .env.example .env

# chat：任意 OpenAI 兼容 API（Letta server 用 OPENAI_API_KEY 鉴权）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
LETTA_MODEL=deepseek-chat

# embedding：本地 fastembed，模型缓存与 HF 镜像
HF_ENDPOINT=https://hf-mirror.com
FASTEMBED_CACHE_PATH=/Users/yourname/.cache/fastembed
