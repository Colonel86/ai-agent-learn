# 复制成 .env 后填入自己的 key。
#
# 默认接 DeepSeek。换成任何 OpenAI 兼容后端(真 OpenAI、通义、本地 vLLM/Ollama)
# 只需要改这三行,代码不用动。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-v4-flash

# fastembed 本地 embedding 模型的缓存目录(不设会落到临时目录,每次重下)
FASTEMBED_CACHE_PATH=~/.cache/fastembed

# 检索调参(一般不用改)
# ZB_TOP_K=4
# ZB_SCORE_THRESHOLD=0.75
