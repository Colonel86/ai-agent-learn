# 复制为 .env 并填入你的 API Key
# cp .env.example .env

# 任意 OpenAI 兼容 API 均可(DeepSeek / OpenAI / 其他)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-v4-flash

# fastembed 模型缓存持久化(默认在系统临时目录,会被 macOS 定期清理)
# 注意:必须是绝对路径,fastembed 不展开 ~
FASTEMBED_CACHE_PATH=/Users/yourname/.cache/fastembed
