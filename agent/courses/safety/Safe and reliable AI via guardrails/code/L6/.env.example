# 客户端(main.py)用。cp .env.example .env 并填 key。
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# fastembed 缓存(绝对路径)
FASTEMBED_CACHE_PATH=/Users/yourname/.cache/fastembed

# 可选:HF 镜像
# HF_ENDPOINT=https://hf-mirror.com

# ── 服务器另需 server.env(不提交):
#   DEEPSEEK_API_KEY=<你的key>
#   OPENAI_API_KEY=<你的key>
