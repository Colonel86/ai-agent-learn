# 复制为 .env 并填 key:cp .env.example .env
# 只有第 1 步复现幻觉的 RAG 需要 LLM;validator 本身不需要。
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# fastembed 模型缓存(绝对路径,fastembed 不展开 ~)
FASTEMBED_CACHE_PATH=/Users/yourname/.cache/fastembed

# 可选:HF 模型下载走镜像(NLI 模型 + all-MiniLM)
# HF_ENDPOINT=https://hf-mirror.com
