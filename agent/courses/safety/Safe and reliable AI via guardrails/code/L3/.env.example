# 客户端(main.py)用。复制为 .env 并填 key:
#   cp .env.example .env
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# fastembed 模型缓存(绝对路径,fastembed 不展开 ~)
FASTEMBED_CACHE_PATH=/Users/yourname/.cache/fastembed

# ── 服务器另需一个 server.env(不要提交),内容:
#   DEEPSEEK_API_KEY=<你的key>
#   OPENAI_API_KEY=<你的key>
# 供 guardrails 服务器里的 litellm 用 deepseek/ 路由到 DeepSeek。
